{
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api?seo=product&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?seo=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api?seo=robots"
    }
  ],
  "headers": [
    {
      "source": "/api",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(app.js|style.css|config.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api?cron=qikink-sync",
      "schedule": "0 3 * * *"
    }
  ]
}
